#!/bin/sh /etc/rc.common
# JanusFlow (雅努斯流 · janusflow.cn / JanusFlow.net / atooli.com)
# OpenWrt procd init script: /etc/init.d/janusflow-probe

START=95
STOP=10
USE_PROCD=1

PROG="/usr/bin/python3"
AGENT="/usr/bin/janusflow-openwrt-probe"
CONF="/etc/janusflow/probe.env"

start_service() {
    [ -f "$CONF" ] && . "$CONF"

    IFACE="${JANUSFLOW_IFACE:-br-lan}"
    DEVICE_ID="${JANUSFLOW_DEVICE_ID:-openwrt-gw-01}"
    LOCAL_CIDR="${JANUSFLOW_LOCAL_CIDR:-10.0.0.0/8}"
    INTERVAL="${JANUSFLOW_INTERVAL:-60}"
    MODE="${JANUSFLOW_MODE:-both}"
    ENDPOINT="${JANUSFLOW_ENDPOINT:-https://www.atooli.com}"

    procd_open_instance "janusflow-probe"
    procd_set_param command "$PROG" "$AGENT" \
        --endpoint "$ENDPOINT" \
        --iface "$IFACE" \
        --device-id "$DEVICE_ID" \
        --local-cidr "$LOCAL_CIDR" \
        --interval "$INTERVAL" \
        --mode "$MODE" \
        --include-conntrack
    procd_set_param env \
        JANUSFLOW_API_KEY="${JANUSFLOW_API_KEY:-}" \
        JANUSFLOW_SIGN_SECRET="${JANUSFLOW_SIGN_SECRET:-}"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
